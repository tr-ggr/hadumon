# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle / local Postgres
DATABASE_URL="postgresql://postgres@localhost:5432/hadumon"

# Better Auth: signs session cookies. Required in production, at least 32
# characters. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""

# The one origin the app is served from. Optional — leave it unset locally and
# on Vercel, where the origin is worked out from the request. Set it when the
# app sits on a custom domain.
# BETTER_AUTH_URL="https://hadumon.example.com"

# Resend, for the password reset email. Optional outside production: with no
# key, the reset link is printed to the server console instead of being sent.
# EMAIL_FROM must be on a domain verified with Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="HaduMon <no-reply@hadumon.example.com>"

# Public origin, used to resolve the Open Graph and Twitter card URLs.
# Optional — leave it unset and the app falls back to the production origin.
# NEXT_PUBLIC_SITE_URL="https://hadumon.vercel.app"
